-- ===================================================================
local VisualsTab = Window:CreateTab({ Name = "Hiển Thị (ESP)" })
local EspContainerSection = VisualsTab:CreateSection({ Name = "ESP Engine v2" })

-- Hàm dựng hiệu ứng Highlight xem xuyên vật thể
local function ApplyHighlight(Character, FrameColor)
    if Character:FindFirstChild("NeptuneESP") then return end
    local Effect = Instance.new("Highlight")
    Effect.Name = "NeptuneESP"
    Effect.FillColor = FrameColor
    Effect.FillTransparency = 0.5
    Effect.OutlineColor = Color3.new(1, 1, 1)
    Effect.OutlineTransparency = 0
    Effect.Parent = Character
end

local function StripHighlight(Character)
    if Character:FindFirstChild("NeptuneESP") then
        Character.NeptuneESP:Destroy()
    end
end

-- Bật/tắt nhìn xuyên vị trí con người (Human)
EspContainerSection:AddToggle({
    Name = "Định Vị Con Người (ESP Human)",
    Value = false,
    Callback = function(State)
        CheatConfig.EspHuman = State
        if not State then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character then StripHighlight(p.Character) end
            end
        end
    end
})

-- Bật/tắt nhìn xuyên vị trí các sinh vật biến dị (Kaiju)
